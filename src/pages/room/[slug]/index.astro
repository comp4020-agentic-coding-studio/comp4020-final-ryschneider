---
import Layout from "../../../layouts/Layout.astro";
import { getRoom, listHeatMarks } from "../../../lib/db";
import { paragraphDensities } from "../../../lib/heat";
import { displayName } from "../../../lib/library";
import { splitParagraphs } from "../../../lib/paragraphs";

const slug = Astro.params.slug!;
const room = getRoom(slug);

if (!room) {
  Astro.response.status = 404;
}

const paragraphs = room ? splitParagraphs(room.text) : [];
const heatMarks = room ? listHeatMarks(slug).map(({ startOffset, endOffset }) => ({ start: startOffset, end: endOffset })) : [];
const densities = paragraphDensities(paragraphs, heatMarks);

const roomData = { slug, paragraphs, heatMarks };
---

<Layout title={room ? `Margins — ${displayName(room)}` : "Margins — not found"}>
  {
    !room ? (
      <main class="page">
        <h1>Not found</h1>
        <p>There's no room called "{slug}".</p>
      </main>
    ) : (
      <main class="page room-page">
        <header class="room-header">
          <h1>{displayName(room)}</h1>
          <p class="room-byline">
            a {room.kind} by {room.author}, from {room.sourceNote}
          </p>
          <p class="room-description">{room.description}</p>
        </header>

        <div id="room" class="room">
          <article id="room-text" class="room-text">
            {paragraphs.map((p, i) => (
              <p data-start={p.start} data-end={p.end} style={`--heat: ${densities[i]}`}>
                {p.text}
              </p>
            ))}
          </article>
          <aside id="presence" class="margin-notes" aria-label="Who's here" />
        </div>

        <script type="application/json" id="room-data" set:html={JSON.stringify(roomData)} />
        <script>
          import { getHandle } from "../../../lib/session";
          import { initRoom } from "../../../scripts/margins-client";

          // Logging in happens on the homepage, not here --- a visit with no
          // name for the session yet is bounced there, and back again once
          // one's set (see src/pages/index.astro).
          const handle = getHandle();
          if (!handle) {
            const back = encodeURIComponent(location.pathname);
            location.replace(`/?next=${back}`);
          } else {
            initRoom(handle);
          }
        </script>
      </main>
    )
  }
</Layout>

<style>
  /* .page defaults to --page-width (global.css); this page widens further
     still, for the text+sidebar grid below. */
  .room-page {
    max-width: var(--room-width);
  }

  .room-header {
    margin-bottom: var(--space-4);
  }

  .room-page h1 {
    font-style: italic;
    margin-bottom: 0.3rem;
  }

  .room-byline {
    font-size: 0.9rem;
    color: var(--ink-muted);
    margin: 0 0 0.6rem;
  }

  .room-description {
    font-family: var(--font-serif);
    color: var(--ink-muted);
    margin: 0;
  }

  .room {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) 12rem;
    gap: var(--space-4);
    align-items: start;
  }

  .room-text {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .room-text p {
    /* scaled down from the raw density so a fully "hot" paragraph stays
       legible --- the stored value is the real signal, this is just render */
    background-color: rgba(var(--ember-wash), calc(var(--heat, 0) * 0.45));
    white-space: pre-line;
    margin: 0 0 1.4em;
    transition: background-color 0.6s ease;
  }

  /* <mark> elements are inserted by margins-client.ts via
     document.createElement, so they never carry Astro's scoping attribute
     --- :global() is required or this rule silently never matches. */
  .room-text :global(mark) {
    background-color: #e8c27a;
    color: var(--ink);
    padding: 0 0.1em;
    cursor: pointer;
    position: relative;
  }

  /* The note's actual text, shown on hover/focus (mouse, keyboard) and on
     tap via the "open" class margins-client.ts toggles --- :hover alone
     never fires on touch. Generated content isn't reliably read by screen
     readers, so the mark's `title` attribute carries the same text as a
     fallback. */
  .room-text :global(mark::after) {
    content: attr(data-note);
    position: absolute;
    left: 0;
    bottom: 100%;
    margin-bottom: 0.4em;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-style: normal;
    line-height: 1.4;
    padding: 0.5em 0.7em;
    border-radius: 0.2rem;
    width: max-content;
    max-width: 16rem;
    white-space: normal;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
    z-index: 1;
  }

  .room-text :global(mark:hover::after),
  .room-text :global(mark:focus::after),
  .room-text :global(mark.open::after) {
    opacity: 1;
  }

  .margin-notes {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9rem;
    color: var(--presence);
    padding-top: 0.3em;
    border-left: 1px solid var(--line);
    padding-left: var(--space-2);
  }

  /* Same reason as the mark rule above: renderPresence() builds this <ul>
     with document.createElement, so it needs :global() too. */
  .margin-notes :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .margin-notes :global(li) {
    margin-bottom: 0.75em;
  }

  @media (max-width: 42rem) {
    .room {
      grid-template-columns: 1fr;
    }

    .margin-notes {
      border-left: none;
      border-top: 1px solid var(--line);
      padding-left: 0;
      padding-top: var(--space-2);
    }
  }
</style>
