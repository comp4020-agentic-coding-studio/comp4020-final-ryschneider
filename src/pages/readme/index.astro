---
// Rendered per request so a README edit shows up without a rebuild in dev;
// in the deployed image README.md sits alongside the server (see Dockerfile).
import { readFileSync } from "node:fs";
import path from "node:path";
import { marked } from "marked";
import Layout from "../../layouts/Layout.astro";

const markdown = readFileSync(path.join(process.cwd(), "README.md"), "utf8");
const body = marked.parse(markdown);
---

<Layout title="About — Margins">
  <main class="page">
    <article class="prose" set:html={body} />
  </main>
</Layout>
