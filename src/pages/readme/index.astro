---
// Rendered per request so a README edit shows up without a rebuild in dev;
// in the deployed image README.md sits alongside the server (see Dockerfile).
import { readFileSync } from "node:fs";
import path from "node:path";
import { marked } from "marked";

const markdown = readFileSync(path.join(process.cwd(), "README.md"), "utf8");
const body = marked.parse(markdown);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>About</title>
  </head>
  <body>
    <main set:html={body} />
  </body>
</html>
