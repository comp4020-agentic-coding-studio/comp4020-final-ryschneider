---
import Layout from "../layouts/Layout.astro";
import { listRoomsWithActivity } from "../lib/db";
import { displayName, formatDate, listLibraryEntries, timeAgo } from "../lib/library";
import { presenceCount } from "../lib/rooms";

const rooms = listRoomsWithActivity();
const libraryEntries = listLibraryEntries();
const loggedIn = Astro.locals.user !== null;
---

<Layout title="Margins">
  <main class="page">
    <h1>Margins</h1>
    <p class="lede">A small group reads one short text together, live.</p>

    <form id="login-gate" hidden={loggedIn}>
      <div class="auth-toggle" role="radiogroup" aria-label="Log in or sign up">
        <button type="button" class="auth-mode active" data-mode="login" aria-pressed="true">Log in</button>
        <button type="button" class="auth-mode" data-mode="signup" aria-pressed="false">Sign up</button>
      </div>
      <label>
        Username
        <input name="username" required maxlength="40" autocomplete="username" />
      </label>
      <label>
        Password
        <input name="password" type="password" required minlength="8" autocomplete="current-password" />
      </label>
      <button type="submit">Log in</button>
      <p id="auth-error" role="alert" hidden></p>
    </form>

    <div id="rooms" hidden={!loggedIn}>
      <button type="button" id="open-create-room">Start a room</button>

      <dialog id="create-room-dialog">
        <form id="create-room">
          <h2>Start a room</h2>
          <label>
            Text
            <select name="textSlug" required>
              {libraryEntries.map((entry) => <option value={entry.slug}>{entry.title} — {entry.author}</option>)}
            </select>
          </label>
          <label>
            Title
            <input name="title" required maxlength="80" placeholder="Give your room a title" />
          </label>
          <label>
            Max people
            <input name="maxSize" type="number" required min="2" max="50" value="10" />
          </label>
          <div class="create-room-actions">
            <button type="button" id="cancel-create-room">Cancel</button>
            <button type="submit">Create room</button>
          </div>
          <p id="create-room-error" role="alert" hidden></p>
        </form>
      </dialog>

      {
        rooms.length === 0 ? (
          <p>No rooms yet.</p>
        ) : (
          <ul class="room-list">
            {
              rooms.map((room) => {
                const here = presenceCount(room.slug);
                return (
                  <li>
                    <div class="room-main">
                      <a href={`/room/${room.slug}/`}>{displayName(room)}</a>
                      <p class="room-byline">
                        a {room.kind} by {room.author}
                      </p>
                      <p class="room-excerpt">{room.description}</p>
                    </div>
                    <ul class="room-stats">
                      <li>{here === 0 ? "No one here right now" : here === 1 ? "1 person here now" : `${here} people here now`}</li>
                      <li>started {formatDate(room.createdAt)}</li>
                      <li>last annotated {timeAgo(room.lastActivityAt)}</li>
                    </ul>
                  </li>
                );
              })
            }
          </ul>
        )
      }
    </div>

    <p class="about-link"><a href="/readme/">About this app</a></p>

    <script>
      const gate = document.getElementById("login-gate") as HTMLFormElement;
      const errorEl = document.getElementById("auth-error")!;
      const submitButton = gate.querySelector('button[type="submit"]')!;
      const modeButtons = [...gate.querySelectorAll<HTMLButtonElement>(".auth-mode")];
      let mode: "login" | "signup" = "login";

      // A room page redirects here with ?next=/room/<slug>/ when there's no
      // session yet; once logged in, send the visitor back to the room they
      // actually wanted instead of stopping at the room list. Restricted to
      // an in-app room path --- next is attacker-controlled (anyone can
      // craft a link to this page with any ?next value), and handing it
      // straight to location.replace would be an open redirect.
      const rawNext = new URLSearchParams(location.search).get("next");
      const next = rawNext && /^\/room\/[^/]+\/$/.test(rawNext) ? rawNext : null;

      // Already logged in? The server rendered the gate hidden (see the
      // frontmatter's Astro.locals.user check) --- go straight to the room
      // they wanted instead of stopping at the room list.
      if (gate.hidden && next) location.replace(next);

      function setMode(newMode: "login" | "signup"): void {
        mode = newMode;
        for (const btn of modeButtons) {
          const active = btn.dataset.mode === mode;
          btn.classList.toggle("active", active);
          btn.setAttribute("aria-pressed", String(active));
        }
        submitButton.textContent = mode === "login" ? "Log in" : "Sign up";
        const password = gate.querySelector<HTMLInputElement>('input[name="password"]')!;
        password.autocomplete = mode === "login" ? "current-password" : "new-password";
        errorEl.hidden = true;
      }

      for (const btn of modeButtons) {
        btn.addEventListener("click", () => setMode(btn.dataset.mode as "login" | "signup"));
      }

      gate.addEventListener("submit", async (e) => {
        e.preventDefault();
        const username = gate.querySelector<HTMLInputElement>('input[name="username"]')?.value.trim();
        const password = gate.querySelector<HTMLInputElement>('input[name="password"]')?.value;
        if (!username || !password) return;

        errorEl.hidden = true;
        const res = await fetch(`/api/auth/${mode}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ username, password }),
        }).catch(() => null);

        if (!res || !res.ok) {
          const body = await res?.json().catch(() => null);
          errorEl.textContent = body?.error ?? "Something went wrong --- try again.";
          errorEl.hidden = false;
          return;
        }

        if (next) location.replace(next);
        else location.reload();
      });

      const createRoomDialog = document.getElementById("create-room-dialog") as HTMLDialogElement | null;
      const openCreateRoom = document.getElementById("open-create-room");
      const cancelCreateRoom = document.getElementById("cancel-create-room");
      const createRoomForm = document.getElementById("create-room") as HTMLFormElement | null;
      const createRoomError = document.getElementById("create-room-error");

      openCreateRoom?.addEventListener("click", () => createRoomDialog?.showModal());
      cancelCreateRoom?.addEventListener("click", () => createRoomDialog?.close());

      createRoomForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const textSlug = createRoomForm.querySelector<HTMLSelectElement>('select[name="textSlug"]')?.value;
        const title = createRoomForm.querySelector<HTMLInputElement>('input[name="title"]')?.value.trim();
        const maxSize = Number(createRoomForm.querySelector<HTMLInputElement>('input[name="maxSize"]')?.value);
        if (!textSlug || !title || !maxSize) return;

        createRoomError!.hidden = true;
        const res = await fetch("/api/rooms", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ textSlug, title, maxSize }),
        }).catch(() => null);

        if (!res || !res.ok) {
          const body = await res?.json().catch(() => null);
          createRoomError!.textContent = body?.error ?? "Something went wrong --- try again.";
          createRoomError!.hidden = false;
          return;
        }

        const body = await res.json();
        location.assign(`/room/${body.slug}/`);
      });
    </script>
  </main>
</Layout>

<style>
  .lede {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  #login-gate {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-2);
    margin: var(--space-3) 0 var(--space-4);
    font-size: 0.95rem;
    max-width: var(--measure);
  }

  #login-gate[hidden] {
    display: none;
  }

  .auth-toggle {
    display: flex;
    gap: 0.5rem;
    flex-basis: 100%;
    margin-bottom: 0.2rem;
  }

  .auth-mode {
    font-size: 0.85rem;
    padding: 0.3rem 0.8rem;
    border-color: var(--line);
    color: var(--ink-muted);
  }

  .auth-mode.active {
    border-color: var(--ink);
    color: var(--ink);
  }

  .auth-mode.active:hover {
    background: none;
    color: var(--ink);
  }

  #login-gate label {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    color: var(--ink-muted);
  }

  #login-gate input {
    min-width: 12rem;
  }

  #auth-error {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.85rem;
    color: var(--ember);
  }

  #auth-error[hidden] {
    display: none;
  }

  #open-create-room {
    margin-bottom: var(--space-3);
  }

  #create-room-dialog {
    border: 1px solid var(--line);
    border-radius: 0.3rem;
    padding: var(--space-3);
    width: min(26rem, calc(100vw - 2 * var(--space-2)));
    background: var(--paper);
    color: var(--ink);
  }

  #create-room-dialog::backdrop {
    background: rgba(42, 39, 34, 0.4);
  }

  #create-room {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: 0.95rem;
  }

  #create-room h2 {
    font-size: 1.1rem;
    margin: 0;
  }

  #create-room label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: var(--ink-muted);
  }

  #create-room input,
  #create-room select {
    width: 100%;
  }

  .create-room-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
    margin-top: 0.3rem;
  }

  #create-room-error {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ember);
  }

  #create-room-error[hidden] {
    display: none;
  }

  .room-list {
    list-style: none;
    margin: var(--space-4) 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .room-list > li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
  }

  .room-main {
    min-width: 0;
  }

  .room-list a {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }

  .room-list a:hover {
    color: var(--ember);
  }

  .room-byline {
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin: 0.3rem 0 0;
  }

  .room-excerpt {
    font-family: var(--font-serif);
    color: var(--ink-muted);
    margin: 0.35rem 0 0;
    max-width: var(--measure);
  }

  .room-stats {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    flex-shrink: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
    color: var(--ink-muted);
    text-align: right;
    white-space: nowrap;
  }

  .about-link {
    font-size: 0.9rem;
  }

  .about-link a {
    color: var(--ink-muted);
  }

  @media (max-width: 42rem) {
    #login-gate {
      flex-direction: column;
      align-items: stretch;
    }

    .room-list > li {
      flex-direction: column;
      gap: 0.5rem;
    }

    .room-stats {
      align-items: flex-start;
      text-align: left;
      white-space: normal;
    }
  }
</style>
