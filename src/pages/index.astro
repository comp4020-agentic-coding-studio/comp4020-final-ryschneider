---
import { listRooms } from "../lib/db";

const rooms = listRooms();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Margins</title>
  </head>
  <body>
    <nav aria-label="Primary">
      <a href="/readme/">About this app</a>
    </nav>
    <main>
      <h1>Margins</h1>
      <p>A small group reads one short text together, live.</p>
      {
        rooms.length === 0 ? (
          <p>No rooms yet.</p>
        ) : (
          <ul>
            {rooms.map((room) => (
              <li>
                <a href={`/room/${room.slug}/`}>{room.slug}</a>
              </li>
            ))}
          </ul>
        )
      }
      <p><a href="/readme/">About this app</a></p>
    </main>
  </body>
</html>
