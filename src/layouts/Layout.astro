---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;0,7..72,600;1,7..72,400&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <nav class="site-nav" aria-label="Primary">
      <span class="site-nav-brand">
        <a href="/">Margins</a>
        <a href="/readme/" class="about-link">About this app</a>
      </span>
      {
        user && (
          <span class="site-nav-account">
            <a href="/profile/">Profile</a>
            <form action="/api/auth/logout" method="post" class="logout-form">
              <button type="submit">Log out</button>
            </form>
          </span>
        )
      }
    </nav>
    <slot />
  </body>
</html>
